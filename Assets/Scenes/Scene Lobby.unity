    \uD655\uC778 \uAC00\uB2A5\uD55C 2\uCC28 \uBE4C\uB4DC\uC640 \uB2E4\uB978\uC810
    \n\nNavMesh\uB97C \uC0AC\uC6A9\uD558\uC5EC \uC801AI \uBC30\uCE58\n\uC801 AI \uACF5\uACA9
    \uB8E8\uD504 \uC9C4\uC785\n\uC801 AI \uAC10\uC9C0\uAC8C\uC774\uC9C0 \uD65C\uC131\uD654\n\n============================\n\n\u203B
    \uD604\uC7AC \uC791\uC5C5\uC911\uC778 \uBD80\uBD84\n\n\uC801 AI \uD30C\uC9C0
    \uC0C1\uD0DC \uC218\uC815\uC911\n\uC801 AI \uAC10\uC9C0 \uAC8C\uC774\uC9C0 \uC18D\uB3C4
    \uC218\uC815\uC911\n\uC801 AI Idle \uC0C1\uD0DC\uB85C \uBC1C\uC0AC\uB418\uB294
    \uBD80\uBD84 \uC218\uC815\uC911\nHUD\uC758 \uD0C4\uC57D \uD604\uD669\uC774 \uC801AI\uC640
    \uACF5\uC720\uB418\uB294 \uBD80\uBD84 \uC218\uC815 \uC911\n\n\u203B \uC8FC\uC758\uC0AC\uD56D\n\uC778\uAC8C\uC784
    \uC9C4\uC785\uC804\uC5D0 \uBB34\uAE30\uB97C \uC7A5\uCC29 \uD6C4 \uC9C4\uC785\uD558\uC138\uC694.\n\uD604\uC7AC
    \uC778\uAC8C\uC784 \uC52C\uC5D0\uC11C \uB85C\uBE44\uB85C \uB098\uC624\uAE30 \uBD88\uAC00\uB2A5\uD569\uB2C8\uB2E4."
